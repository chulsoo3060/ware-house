# =====================================================================
#  이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
#  .env 는 절대 공유 금지 (카톡/GitHub/AI 채팅에 붙여넣지 않기)
#  "=" 오른쪽에 값을 붙여서 적기. 따옴표·띄어쓰기 없이.
# =====================================================================

# --- 팀 AE(ae_sjuiot_keyring_2026)를 등록할 때 쓴 인증값 — 팀 담당자에게 받아서 채우기 ---
#     (개인 계정 키로는 팀 AE 에 쓰기 권한이 없을 수 있음)
MOBIUS_AEI=
MOBIUS_API_KEY=
MOBIUS_CUSTOM_LECTURE=
MOBIUS_CUSTOM_CREATOR=

# --- 팀 공통값 ---
MOBIUS_URL=https://onem2m.iotcoss.ac.kr
MOBIUS_CB=Mobius
MOBIUS_AE_RN=ae_sjuiot_keyring_2026

# 내 전용 테스트 폴더 이름 — 팀원끼리 겹치지 않게 본인 것으로 바꾸기
TEST_ROOT=cnt_test_내이름

# 서버가 보고를 올릴 위치. 테스트 중에는 TEST_ROOT 와 같게, 합동 테스트 때만 비움
REPORT_ROOT=cnt_test_내이름

# 장비: fake = 가짜(통신만 확인) / dobot = 키캡 2세트 실제 제어 (Dobot 연결된 PC 에서 pc_gateway.py 로만)
HARDWARE=fake

# assigned(트레이 로봇팔)에 반응할지. 트레이 로봇팔이 없으니 0
REACT_ASSIGNED=0

# 아직 없는 장비(트레이 벨트·보드 로봇팔) 단계에 가짜 done 보고. 끄면(0) 플랫폼 흐름이 멈춤
FAKE_UNBUILT=1

# 장비별 가짜 보고 (비우면 FAKE_UNBUILT 값을 따름). 다른 팀이 직접 보고하는 컨테이너는 0 → 중복 방지
# 담당 범위(2026-09-14): 우리는 tray_reached 를 만드는 section1 까지 → 합동 테스트는 1 / 0 / 0 / 0
FAKE_TRAY_CONVEYOR=
FAKE_TRAY_SECTION2=
FAKE_BOARD_ARM=
FAKE_BOARD_DISPENSE=

# 시뮬레이션이 보고를 기다리는 최대 시간(초). 실제 Dobot 테스트 때는 120
SIM_WAIT_SEC=10

# PC 게이트웨이가 읽을 cnt_process 경로. 비우면 TEST_ROOT/cnt_process, 합동 테스트 때 cnt_process
PROCESS_PATH=

# fault 가 풀린 뒤 keycap_reached 를 '사람이 조치함'으로 보고 (done). 0 이면 저장된 failed 를 그대로 보고
MANUAL_FIX_DONE=1

# 1 = 보고를 실제로 올리지 않고 화면에만 출력 (우리끼리 흐름 확인용). 평소에는 0
DRY_RUN=0

# 테스트용: 일부러 failed 로 보고할 부분. 예) keycap2  또는  keycap1,section1  (평소에는 비워두기)
FORCE_FAIL=

# 두 로봇팔이 트레이 자리를 번갈아 쓸지. 1 = 번갈아(자리가 겹칠 때) / 0 = 동시에 각자 놓기
ARMS_TAKE_TURNS=1

# 센서 확인 (1 = 켬). 센서 연결 전까지 0
CHECK_GRIP_IR=0
CHECK_BOARD_COLOR=0

# 내 서버의 알림 받는 주소 (gcloud VM 외부 IP, 방화벽 5000 포트 열려 있어야 함)
NOTIFY_URL=http://서버외부IP:5000/notify
